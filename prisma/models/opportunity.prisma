enum OpportunityStatus {
  DRAFT
  READY
  MATCHING
  OPEN
  REVIEWING_PROPOSALS
  SHORTLISTING
  SELECTION
  PENDING_PROVIDER_ACCEPTANCE
  FILLED
  CLOSED
  ON_HOLD
  CANCELLED
  EXPIRED

  @@map("opportunity_status")
}

enum OpportunityVisibilityMode {
  DIRECT
  INVITE_ONLY
  ELIGIBLE_NETWORK

  @@map("opportunity_visibility_mode")
}

model Opportunity {
  id          String                    @id @default(uuid())
  companyId   String
  requestId   String?  @unique
  title       String                    @db.VarChar(255)
  description String                    @db.Text
  clientName            String?  @db.VarChar(255)
  ndaRequired           Boolean  @default(false)
  clientIdentityVisible Boolean  @default(false)
  requiredSkills        String[] @default([])
  preferredSkills       String[] @default([])
  seniority             String?  @db.VarChar(100)
  engagementType        String?  @db.VarChar(100)
  budgetMin             Decimal? @db.Decimal(10, 2)
  budgetMax             Decimal? @db.Decimal(10, 2)
  currency              String   @default("USD") @db.VarChar(3)
  duration              String?  @db.VarChar(100)
  startDate             DateTime?
  deadline              DateTime?
  locationTimezone      String?  @db.VarChar(100)
  languages             String[] @default([])
  deliverables          String?  @db.Text
  providerCount         Int      @default(1)
  internalNotes         String?  @db.Text
  rejectionFeedback     String?  @db.Text
  ownerId               String?
  status      OpportunityStatus         @default(DRAFT)
  visibilityMode OpportunityVisibilityMode @default(INVITE_ONLY)
  createdBy   String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  company       Company  @relation(fields: [companyId], references: [id])
  request       Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdByUser User     @relation("OpportunityCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  owner         User?    @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  positions OpportunityPosition[]
  activities OpportunityActivity[]
  documents Document[]

  @@index([companyId, status])
  @@index([companyId, visibilityMode])
  @@index([ownerId])
  @@index([requestId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("opportunity")
}

model OpportunityPosition {
  id              String   @id @default(uuid())
  opportunityId   String
  companyId       String
  title           String   @db.VarChar(255)
  description     String   @db.Text
  requiredSkills  String[] @default([])
  preferredSkills String[] @default([])
  seniority       String?  @db.VarChar(100)
  engagementType  String?  @db.VarChar(100)
  budgetMin       Decimal? @db.Decimal(10, 2)
  budgetMax       Decimal? @db.Decimal(10, 2)
  currency        String   @default("USD") @db.VarChar(3)
  duration        String?  @db.VarChar(100)
  startDate       DateTime?
  deadline        DateTime?
  locationTimezone String? @db.VarChar(100)
  languages       String[] @default([])
  deliverables    String?  @db.Text
  providerCount   Int      @default(1)
  internalNotes   String?  @db.Text
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  company     Company     @relation("OpportunityPositionCompany", fields: [companyId], references: [id])
  documents   Document[]

  @@index([opportunityId])
  @@index([companyId])
  @@index([createdAt])
  @@map("opportunity_position")
}

enum OpportunityActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  VISIBILITY_CHANGED
  POSITION_ADDED
  POSITION_UPDATED
  POSITION_REMOVED
  NOTE_ADDED
  FILLED
  CLOSED
  CANCELLED
  REACTIVATED

  @@map("opportunity_activity_type")
}

model OpportunityActivity {
  id             String                @id @default(uuid())
  companyId      String
  opportunityId  String
  actorId        String
  type           OpportunityActivityType
  fromStatus     OpportunityStatus?
  toStatus       OpportunityStatus?
  fromVisibility OpportunityVisibilityMode?
  toVisibility   OpportunityVisibilityMode?
  createdAt      DateTime              @default(now())

  company      Company           @relation(fields: [companyId], references: [id])
  opportunity  Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor        User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@index([companyId, createdAt])
  @@index([actorId])
  @@map("opportunity_activity")
}
