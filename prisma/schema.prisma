generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientRole {
  OWNER
  ADMINISTRATOR
  PROJECT_MEMBER
  BILLING
  VIEWER

  @@map("client_role")
}

enum SdkStaffRole {
  ADMIN
  DELIVERY
  FINANCE

  @@map("sdk_staff_role")
}

enum InvitationKind {
  CLIENT
  SDK_STAFF
  SERVICE_PROVIDER

  @@map("invitation_kind")
}

enum InvitationDeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("invitation_delivery_status")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("priority")
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  INFORMATION_REQUIRED
  PROPOSAL_READY
  APPROVED
  REJECTED
  CLOSED

  @@map("request_status")
}

enum RequestActivityType {
  CREATED
  UPDATED
  SUBMITTED
  REVIEW_STARTED
  INFORMATION_REQUESTED
  INFORMATION_PROVIDED
  PROPOSAL_READY
  ACCEPTED
  REJECTED
  CONVERTED_TO_PROJECT

  @@map("request_activity_type")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED

  @@map("project_status")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED

  @@map("milestone_status")
}

enum DocumentStatus {
  DRAFT
  UPLOADED
  ARCHIVED
  DELETED

  @@map("document_status")
}

enum MessageStatus {
  SENT
  READ
  ARCHIVED
  DELETED

  @@map("message_status")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  REFUNDED

  @@map("invoice_status")
}

enum ServiceProviderStatus {
  APPLICANT
  ONBOARDING
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
  ARCHIVED

  @@map("service_provider_status")
}

enum ProviderAssignmentStatus {
  INVITED
  ACTIVE
  PAUSED
  ENDED
  CANCELLED

  @@map("provider_assignment_status")
}

enum ProviderCompensationType {
  HOURLY
  DAILY
  FIXED_FEE

  @@map("provider_compensation_type")
}

enum ComplianceRequirementStatus {
  MISSING
  SUBMITTED
  CHANGES_REQUIRED
  VERIFIED
  REJECTED
  EXPIRED
  WAIVED

  @@map("compliance_requirement_status")
}

enum ProviderDocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
  EXPIRED
  ARCHIVED
  DELETED

  @@map("provider_document_status")
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  CLIENT_REVIEW
  SDK_REVIEW
  CHANGES_REQUIRED
  APPROVED
  REJECTED
  INVOICED

  @@map("time_entry_status")
}

enum ProviderInvoiceStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUIRED
  APPROVED
  REJECTED
  PAID
  VOID

  @@map("provider_invoice_status")
}

enum ProviderInvoiceLineType {
  TIME
  FIXED_FEE
  ADJUSTMENT

  @@map("provider_invoice_line_type")
}

enum FormTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("form_template_status")
}

enum FormResponseStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUIRED
  APPROVED
  REJECTED

  @@map("form_response_status")
}

enum AutomationEventType {
  PROVIDER_CHANGED
  DOCUMENT_SUBMITTED
  DOCUMENT_REVIEWED
  FORM_SUBMITTED
  FORM_REVIEWED
  TIME_SUBMITTED
  TIME_REVIEWED
  INVOICE_SUBMITTED
  INVOICE_REVIEWED
  DUE_SOON
  OVERDUE

  @@map("automation_event_type")
}

enum AutomationDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRYING
  FAILED
  CANCELLED

  @@map("automation_delivery_status")
}

model User {
  id              String        @id @default(uuid())
  auth0Sub        String        @unique
  email           String        @unique @db.VarChar(255)
  name            String        @db.VarChar(255)
  avatarUrl       String?       @db.VarChar(1024)
  preferredLocale String        @default("en") @db.VarChar(5)
  sdkStaffRole    SdkStaffRole?
  isActive        Boolean       @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships         Membership[]      @relation("UserMemberships")
  invitedMembers      Membership[]      @relation("MembershipInvitations")
  requests            Request[]         @relation("RequestSubmittedBy")
  reviewedRequests    Request[]         @relation("RequestReviewedBy")
  requestActivities   RequestActivity[]
  projects            Project[]         @relation("ProjectCreatedBy")
  messages            Message[]
  invoices            Invoice[]
  documents           Document[]
  sentInvitations     Invitation[]      @relation("InvitationInviter")
  acceptedInvitations Invitation[]      @relation("InvitationAcceptor")
  providerProfile     ServiceProviderProfile?
  providerReviews     ComplianceRequirement[] @relation("ComplianceReviewer")
  reviewedTimeEntries TimeEntry[]       @relation("TimeEntryReviewer")
  reviewedProviderInvoices ProviderInvoice[] @relation("ProviderInvoiceReviewer")
  providerAuditEvents ProviderAuditEvent[]
  notifications       Notification[]

  @@index([email])
  @@index([auth0Sub])
  @@index([createdAt])
  @@map("user")
}

model Company {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]      @relation("CompanyMemberships")
  requests          Request[]
  requestActivities RequestActivity[]
  projects          Project[]
  milestones        Milestone[]
  documents         Document[]
  messages          Message[]
  invoices          Invoice[]
  invitations       Invitation[]
  providerAssignments ProviderAssignment[]

  @@index([slug])
  @@index([createdAt])
  @@map("company")
}

model Invitation {
  id             String                   @id @default(uuid())
  tokenHash      String                   @unique @db.VarChar(64)
  email          String                   @db.VarChar(255)
  kind           InvitationKind
  companyId      String?
  clientRole     ClientRole?
  sdkStaffRole   SdkStaffRole?
  providerApplicationId String? @unique
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedBy     String?
  revokedAt      DateTime?
  deliveryStatus InvitationDeliveryStatus @default(PENDING)
  lastSentAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  company  Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inviter  User     @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict)
  acceptor User?    @relation("InvitationAcceptor", fields: [acceptedBy], references: [id], onDelete: SetNull)
  providerApplication ProviderApplication? @relation(fields: [providerApplicationId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([companyId])
  @@index([invitedBy])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("invitation")
}

model Membership {
  id        String     @id @default(uuid())
  userId    String
  companyId String
  role      ClientRole @default(PROJECT_MEMBER)
  invitedBy String?
  invitedAt DateTime?
  joinedAt  DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user    User    @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation("CompanyMemberships", fields: [companyId], references: [id], onDelete: Cascade)
  inviter User?   @relation("MembershipInvitations", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([userId])
  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@index([createdAt])
  @@map("membership")
}

model Request {
  id                    String        @id @default(uuid())
  companyId             String
  title                 String        @db.VarChar(255)
  description           String        @db.Text
  capability            String        @default("other") @db.VarChar(100)
  businessContext       String?       @db.Text
  supportingInformation String?       @db.Text
  supportingLinks       String[]      @default([])
  status                RequestStatus @default(DRAFT)
  priority              Priority      @default(MEDIUM)
  submittedBy           String
  reviewedBy            String?
  reviewedAt            DateTime?
  closedAt              DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company         Company @relation(fields: [companyId], references: [id])
  submittedByUser User    @relation("RequestSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict)
  reviewedByUser  User?   @relation("RequestReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  projects   Project[]
  documents  Document[]
  messages   Message[]
  invoices   Invoice[]
  activities RequestActivity[]

  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([submittedBy])
  @@index([createdAt])
  @@map("request")
}

model RequestActivity {
  id         String              @id @default(uuid())
  companyId  String
  requestId  String
  actorId    String
  type       RequestActivityType
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  createdAt  DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id])
  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([requestId, createdAt])
  @@index([actorId])
  @@map("request_activity")
}

model Project {
  id          String        @id @default(uuid())
  companyId   String
  requestId   String?
  name        String        @db.VarChar(255)
  description String        @db.Text
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company       Company  @relation(fields: [companyId], references: [id])
  request       Request? @relation(fields: [requestId], references: [id])
  createdByUser User     @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  milestones Milestone[]
  documents  Document[]
  messages   Message[]
  invoices   Invoice[]
  providerAssignments ProviderAssignment[]
  providerFormTemplates ProviderFormTemplate[]

  @@index([companyId])
  @@index([requestId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("project")
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  companyId   String
  name        String          @db.VarChar(255)
  description String          @db.Text
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  documents Document[]
  messages  Message[]
  invoices  Invoice[]
  timeEntries TimeEntry[]
  providerInvoiceLines ProviderInvoiceLine[]

  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@map("milestone")
}

model Document {
  id          String         @id @default(uuid())
  companyId   String
  projectId   String?
  milestoneId String?
  requestId   String?
  name        String         @db.VarChar(255)
  storageKey  String         @db.VarChar(1024)
  mimeType    String         @db.VarChar(255)
  sizeBytes   Int
  status      DocumentStatus @default(DRAFT)
  uploadedBy  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company        Company    @relation(fields: [companyId], references: [id])
  project        Project?   @relation(fields: [projectId], references: [id])
  milestone      Milestone? @relation(fields: [milestoneId], references: [id])
  request        Request?   @relation(fields: [requestId], references: [id])
  uploadedByUser User       @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([requestId])
  @@index([uploadedBy])
  @@index([status])
  @@index([createdAt])
  @@map("document")
}

model Message {
  id              String        @id @default(uuid())
  companyId       String
  projectId       String?
  milestoneId     String?
  requestId       String?
  content         String        @db.Text
  authorId        String
  parentMessageId String?
  status          MessageStatus @default(SENT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company       Company    @relation(fields: [companyId], references: [id])
  project       Project?   @relation(fields: [projectId], references: [id])
  milestone     Milestone? @relation(fields: [milestoneId], references: [id])
  request       Request?   @relation(fields: [requestId], references: [id])
  author        User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parentMessage Message?   @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies       Message[]  @relation("MessageReplies")

  @@index([companyId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([requestId])
  @@index([authorId])
  @@index([parentMessageId])
  @@index([status])
  @@index([createdAt])
  @@map("message")
}

model Invoice {
  id          String        @id @default(uuid())
  companyId   String
  projectId   String?
  milestoneId String?
  requestId   String?
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD") @db.VarChar(3)
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime?
  paidAt      DateTime?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company       Company    @relation(fields: [companyId], references: [id])
  project       Project?   @relation(fields: [projectId], references: [id])
  milestone     Milestone? @relation(fields: [milestoneId], references: [id])
  request       Request?   @relation(fields: [requestId], references: [id])
  createdByUser User       @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([requestId])
  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
  @@map("invoice")
}

model Enquiry {
  id          String   @id @default(uuid())
  companyName String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  website     String?  @db.VarChar(1024)
  capability  String   @db.VarChar(255)
  description String   @db.Text
  environment String?  @db.Text
  timeline    String?  @db.VarChar(255)
  budgetRange String?  @db.VarChar(255)
  context     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("enquiry")
}

model ProviderApplication {
  id                    String   @id @default(uuid())
  email                 String   @db.VarChar(255)
  name                  String   @db.VarChar(255)
  countryCode           String   @db.Char(2)
  professionalHeadline  String   @db.VarChar(255)
  profileSummary        String   @db.Text
  portfolioUrl          String?  @db.VarChar(1024)
  privacyAcceptedAt     DateTime
  reviewedAt            DateTime?
  reviewedBy            String?
  invitedAt             DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  invitation Invitation?

  @@index([email, createdAt])
  @@index([countryCode])
  @@map("provider_application")
}

model ServiceProviderProfile {
  id                    String                @id @default(uuid())
  userId                String                @unique
  status                ServiceProviderStatus @default(ONBOARDING)
  legalName             String?               @db.VarChar(255)
  tradingName           String?               @db.VarChar(255)
  professionalHeadline  String?               @db.VarChar(255)
  professionalEmail     String?               @db.VarChar(255)
  professionalPhone     String?               @db.VarChar(50)
  addressLine1          String?               @db.VarChar(255)
  addressLine2          String?               @db.VarChar(255)
  city                  String?               @db.VarChar(120)
  postalCode            String?               @db.VarChar(32)
  countryCode           String?               @db.Char(2)
  taxResidenceCode      String?               @db.Char(2)
  registrationIdEncrypted String?              @db.Text
  taxIdEncrypted        String?               @db.Text
  vatIdEncrypted        String?               @db.Text
  payoutDetailsEncrypted String?              @db.Text
  declarations          Json?
  submittedAt           DateTime?
  approvedAt            DateTime?
  suspendedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   ProviderAssignment[]
  requirements  ComplianceRequirement[]
  documents     ProviderDocument[]
  invoices      ProviderInvoice[]
  formResponses ProviderFormResponse[]

  @@index([status])
  @@index([countryCode])
  @@map("service_provider_profile")
}

model ComplianceChecklistTemplate {
  id             String   @id @default(uuid())
  countryCode    String   @db.Char(2)
  classification String   @db.VarChar(100)
  name           String   @db.VarChar(255)
  version        Int
  requirements   Json
  isPublished    Boolean  @default(false)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  providerRequirements ComplianceRequirement[]

  @@unique([countryCode, classification, version])
  @@index([countryCode, isPublished])
  @@map("compliance_checklist_template")
}

model ComplianceRequirement {
  id             String                      @id @default(uuid())
  providerId     String
  checklistId    String
  requirementKey String                      @db.VarChar(120)
  label          String                      @db.VarChar(255)
  status         ComplianceRequirementStatus @default(MISSING)
  evidence       Json?
  validFrom      DateTime?
  expiresAt      DateTime?
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNotes    String?                     @db.Text
  waivedReason   String?                     @db.Text
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  provider  ServiceProviderProfile       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  checklist ComplianceChecklistTemplate  @relation(fields: [checklistId], references: [id], onDelete: Restrict)
  reviewer  User?                        @relation("ComplianceReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  documents ProviderDocument[]

  @@unique([providerId, requirementKey])
  @@index([providerId, status])
  @@index([expiresAt])
  @@map("compliance_requirement")
}

model ProviderDocument {
  id             String                 @id @default(uuid())
  providerId     String
  requirementId  String?
  documentType   String                 @db.VarChar(120)
  version        Int                    @default(1)
  originalName   String                 @db.VarChar(255)
  storageKey     String                 @unique @db.VarChar(1024)
  mimeType       String                 @db.VarChar(255)
  sizeBytes      Int
  checksum       String?                @db.VarChar(128)
  status         ProviderDocumentStatus @default(UPLOADED)
  expiresAt      DateTime?
  retentionUntil DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  provider    ServiceProviderProfile  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  requirement ComplianceRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([providerId, status])
  @@index([requirementId])
  @@index([expiresAt])
  @@map("provider_document")
}

model ProviderAssignment {
  id                         String                       @id @default(uuid())
  providerId                 String
  companyId                  String
  projectId                  String
  status                     ProviderAssignmentStatus     @default(INVITED)
  roleTitle                  String                       @db.VarChar(255)
  startsOn                   DateTime?
  endsOn                     DateTime?
  clientTimeApprovalRequired Boolean                      @default(false)
  contactVisibleToClient     Boolean                      @default(true)
  compensationType           ProviderCompensationType
  rateAmount                 Decimal                      @db.Decimal(12, 2)
  currency                   String                       @db.VarChar(3)
  unitsPerDay                Decimal?                     @db.Decimal(5, 2)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  provider ServiceProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  company  Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project  Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  timeEntries TimeEntry[]
  invoices ProviderInvoice[]
  formResponses ProviderFormResponse[]

  @@unique([providerId, projectId])
  @@index([companyId, projectId])
  @@index([providerId, status])
  @@map("provider_assignment")
}

model TimeEntry {
  id                 String          @id @default(uuid())
  assignmentId       String
  milestoneId        String?
  workDate           DateTime        @db.Date
  durationMinutes    Int
  description        String          @db.Text
  status             TimeEntryStatus @default(DRAFT)
  submittedAt        DateTime?
  clientReviewedAt   DateTime?
  sdkReviewedAt      DateTime?
  reviewedBy         String?
  reviewNotes        String?         @db.Text
  replacesTimeEntryId String?        @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  assignment ProviderAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  milestone  Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  reviewer   User?              @relation("TimeEntryReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  replaces   TimeEntry?         @relation("TimeEntryReplacement", fields: [replacesTimeEntryId], references: [id], onDelete: SetNull)
  replacement TimeEntry?        @relation("TimeEntryReplacement")
  invoiceLine ProviderInvoiceLine?

  @@index([assignmentId, workDate])
  @@index([status])
  @@map("time_entry")
}

model ProviderInvoice {
  id                       String                @id @default(uuid())
  providerId               String
  assignmentId             String
  supplierInvoiceNumber    String                @db.VarChar(100)
  status                   ProviderInvoiceStatus @default(DRAFT)
  issueDate                DateTime              @db.Date
  dueDate                  DateTime?             @db.Date
  currency                 String                @db.VarChar(3)
  subtotal                 Decimal               @db.Decimal(12, 2)
  taxAmount                Decimal               @db.Decimal(12, 2)
  total                    Decimal               @db.Decimal(12, 2)
  providerLegalSnapshot    Json
  sdkBillingEntitySnapshot Json
  originalDocumentId       String?
  reviewerNotes            String?               @db.Text
  reviewedBy               String?
  approvedAt               DateTime?
  paidAt                   DateTime?
  paymentReference         String?               @db.VarChar(255)
  submittedAt              DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  provider   ServiceProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  assignment ProviderAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  reviewer   User?                  @relation("ProviderInvoiceReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  lines      ProviderInvoiceLine[]

  @@unique([providerId, supplierInvoiceNumber])
  @@index([providerId, status])
  @@index([assignmentId])
  @@map("provider_invoice")
}

model ProviderInvoiceLine {
  id           String                  @id @default(uuid())
  invoiceId    String
  timeEntryId  String?                 @unique
  milestoneId  String?
  type         ProviderInvoiceLineType
  description  String                  @db.VarChar(500)
  quantity     Decimal                 @db.Decimal(10, 2)
  unitAmount   Decimal                 @db.Decimal(12, 2)
  netAmount    Decimal                 @db.Decimal(12, 2)
  adjustmentReason String?             @db.Text
  createdAt    DateTime                @default(now())

  invoice   ProviderInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntry TimeEntry?       @relation(fields: [timeEntryId], references: [id], onDelete: Restrict)
  milestone Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("provider_invoice_line")
}

model ProviderFormTemplate {
  id          String             @id @default(uuid())
  projectId   String
  name        String             @db.VarChar(255)
  description String?            @db.Text
  status      FormTemplateStatus @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  ProviderFormVersion[]
  responses ProviderFormResponse[]

  @@index([projectId, status])
  @@map("provider_form_template")
}

model ProviderFormVersion {
  id          String   @id @default(uuid())
  templateId  String
  version     Int
  schema      Json
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  template  ProviderFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responses ProviderFormResponse[]

  @@unique([templateId, version])
  @@map("provider_form_version")
}

model ProviderFormResponse {
  id               String             @id @default(uuid())
  templateId       String
  versionId        String
  providerId       String
  assignmentId     String
  status           FormResponseStatus @default(DRAFT)
  values           Json
  clientVisible    Boolean            @default(false)
  assignedReviewer String?
  dueAt            DateTime?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewNotes      String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  template   ProviderFormTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version    ProviderFormVersion     @relation(fields: [versionId], references: [id], onDelete: Restrict)
  provider   ServiceProviderProfile  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  assignment ProviderAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([assignmentId, status])
  @@index([providerId])
  @@index([dueAt])
  @@map("provider_form_response")
}

model AutomationRule {
  id               String              @id @default(uuid())
  name             String              @db.VarChar(255)
  version          Int
  eventType        AutomationEventType
  conditions       Json
  actions          Json
  webhookUrl       String?             @db.VarChar(2048)
  webhookSecretEncrypted String?       @db.Text
  isEnabled        Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  deliveries AutomationDelivery[]

  @@unique([name, version])
  @@index([eventType, isEnabled])
  @@map("automation_rule")
}

model AutomationDelivery {
  id             String                   @id @default(uuid())
  ruleId         String
  idempotencyKey String                   @unique @db.VarChar(255)
  status         AutomationDeliveryStatus @default(PENDING)
  eventPayload   Json
  attemptCount   Int                      @default(0)
  nextAttemptAt  DateTime?
  lastError      String?                  @db.Text
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  rule     AutomationRule          @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  attempts AutomationAttempt[]

  @@index([status, nextAttemptAt])
  @@map("automation_delivery")
}

model AutomationAttempt {
  id          String   @id @default(uuid())
  deliveryId  String
  attempt     Int
  responseCode Int?
  error       String?  @db.Text
  startedAt   DateTime @default(now())
  completedAt DateTime?

  delivery AutomationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attempt])
  @@map("automation_attempt")
}

model ProviderAuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  providerId String?
  entityType String   @db.VarChar(100)
  entityId   String   @db.VarChar(255)
  action     String   @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([providerId, createdAt])
  @@index([entityType, entityId])
  @@map("provider_audit_event")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String   @db.VarChar(255)
  body      String   @db.Text
  href      String?  @db.VarChar(1024)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notification")
}
