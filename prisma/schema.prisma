generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientRole {
  OWNER
  ADMINISTRATOR
  PROJECT_MEMBER
  BILLING
  VIEWER

  @@map("client_role")
}

enum SdkStaffRole {
  ADMIN
  DELIVERY
  FINANCE

  @@map("sdk_staff_role")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("priority")
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  INFORMATION_REQUIRED
  PROPOSAL_READY
  APPROVED
  REJECTED
  CLOSED

  @@map("request_status")
}

enum RequestActivityType {
  CREATED
  UPDATED
  SUBMITTED
  REVIEW_STARTED
  INFORMATION_REQUESTED
  INFORMATION_PROVIDED
  PROPOSAL_READY
  ACCEPTED
  REJECTED
  CONVERTED_TO_PROJECT

  @@map("request_activity_type")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED

  @@map("project_status")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED

  @@map("milestone_status")
}

enum DocumentStatus {
  DRAFT
  UPLOADED
  ARCHIVED
  DELETED

  @@map("document_status")
}

enum MessageStatus {
  SENT
  READ
  ARCHIVED
  DELETED

  @@map("message_status")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  REFUNDED

  @@map("invoice_status")
}

model User {
  id           String        @id @default(uuid())
  auth0Sub     String        @unique
  email        String        @unique @db.VarChar(255)
  name         String        @db.VarChar(255)
  avatarUrl    String?       @db.VarChar(1024)
  sdkStaffRole SdkStaffRole?
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships       Membership[]      @relation("UserMemberships")
  invitedMembers    Membership[]      @relation("MembershipInvitations")
  requests          Request[]         @relation("RequestSubmittedBy")
  reviewedRequests  Request[]         @relation("RequestReviewedBy")
  requestActivities RequestActivity[]
  projects          Project[]         @relation("ProjectCreatedBy")
  messages          Message[]
  invoices          Invoice[]
  documents         Document[]

  @@index([email])
  @@index([auth0Sub])
  @@index([createdAt])
  @@map("user")
}

model Company {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]      @relation("CompanyMemberships")
  requests          Request[]
  requestActivities RequestActivity[]
  projects          Project[]
  milestones        Milestone[]
  documents         Document[]
  messages          Message[]
  invoices          Invoice[]

  @@index([slug])
  @@index([createdAt])
  @@map("company")
}

model Membership {
  id        String     @id @default(uuid())
  userId    String
  companyId String
  role      ClientRole @default(PROJECT_MEMBER)
  invitedBy String?
  invitedAt DateTime?
  joinedAt  DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user    User    @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation("CompanyMemberships", fields: [companyId], references: [id], onDelete: Cascade)
  inviter User?   @relation("MembershipInvitations", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([userId])
  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@index([createdAt])
  @@map("membership")
}

model Request {
  id                    String        @id @default(uuid())
  companyId             String
  title                 String        @db.VarChar(255)
  description           String        @db.Text
  capability            String        @default("other") @db.VarChar(100)
  businessContext       String?       @db.Text
  supportingInformation String?       @db.Text
  supportingLinks       String[]      @default([])
  status                RequestStatus @default(DRAFT)
  priority              Priority      @default(MEDIUM)
  submittedBy           String
  reviewedBy            String?
  reviewedAt            DateTime?
  closedAt              DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company         Company @relation(fields: [companyId], references: [id])
  submittedByUser User    @relation("RequestSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict)
  reviewedByUser  User?   @relation("RequestReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  projects   Project[]
  documents  Document[]
  messages   Message[]
  invoices   Invoice[]
  activities RequestActivity[]

  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([submittedBy])
  @@index([createdAt])
  @@map("request")
}

model RequestActivity {
  id         String              @id @default(uuid())
  companyId  String
  requestId  String
  actorId    String
  type       RequestActivityType
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  createdAt  DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id])
  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([requestId, createdAt])
  @@index([actorId])
  @@map("request_activity")
}

model Project {
  id          String        @id @default(uuid())
  companyId   String
  requestId   String?
  name        String        @db.VarChar(255)
  description String        @db.Text
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company       Company  @relation(fields: [companyId], references: [id])
  request       Request? @relation(fields: [requestId], references: [id])
  createdByUser User     @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  milestones Milestone[]
  documents  Document[]
  messages   Message[]
  invoices   Invoice[]

  @@index([companyId])
  @@index([requestId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("project")
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  companyId   String
  name        String          @db.VarChar(255)
  description String          @db.Text
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  documents Document[]
  messages  Message[]
  invoices  Invoice[]

  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@map("milestone")
}

model Document {
  id          String         @id @default(uuid())
  companyId   String
  projectId   String?
  milestoneId String?
  requestId   String?
  name        String         @db.VarChar(255)
  storageKey  String         @db.VarChar(1024)
  mimeType    String         @db.VarChar(255)
  sizeBytes   Int
  status      DocumentStatus @default(DRAFT)
  uploadedBy  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company        Company    @relation(fields: [companyId], references: [id])
  project        Project?   @relation(fields: [projectId], references: [id])
  milestone      Milestone? @relation(fields: [milestoneId], references: [id])
  request        Request?   @relation(fields: [requestId], references: [id])
  uploadedByUser User       @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([requestId])
  @@index([uploadedBy])
  @@index([status])
  @@index([createdAt])
  @@map("document")
}

model Message {
  id              String        @id @default(uuid())
  companyId       String
  projectId       String?
  milestoneId     String?
  requestId       String?
  content         String        @db.Text
  authorId        String
  parentMessageId String?
  status          MessageStatus @default(SENT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company       Company    @relation(fields: [companyId], references: [id])
  project       Project?   @relation(fields: [projectId], references: [id])
  milestone     Milestone? @relation(fields: [milestoneId], references: [id])
  request       Request?   @relation(fields: [requestId], references: [id])
  author        User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parentMessage Message?   @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies       Message[]  @relation("MessageReplies")

  @@index([companyId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([requestId])
  @@index([authorId])
  @@index([parentMessageId])
  @@index([status])
  @@index([createdAt])
  @@map("message")
}

model Invoice {
  id          String        @id @default(uuid())
  companyId   String
  projectId   String?
  milestoneId String?
  requestId   String?
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD") @db.VarChar(3)
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime?
  paidAt      DateTime?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company       Company    @relation(fields: [companyId], references: [id])
  project       Project?   @relation(fields: [projectId], references: [id])
  milestone     Milestone? @relation(fields: [milestoneId], references: [id])
  request       Request?   @relation(fields: [requestId], references: [id])
  createdByUser User       @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([requestId])
  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
  @@map("invoice")
}

model Enquiry {
  id          String   @id @default(uuid())
  companyName String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  website     String?  @db.VarChar(1024)
  capability  String   @db.VarChar(255)
  description String   @db.Text
  environment String?  @db.Text
  timeline    String?  @db.VarChar(255)
  budgetRange String?  @db.VarChar(255)
  context     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("enquiry")
}
