generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientRole {
  OWNER
  ADMINISTRATOR
  PROJECT_MEMBER
  BILLING
  VIEWER

  @@map("client_role")
}

enum SdkStaffRole {
  ADMIN
  DELIVERY
  FINANCE

  @@map("sdk_staff_role")
}

enum InvitationKind {
  CLIENT
  SDK_STAFF

  @@map("invitation_kind")
}

enum InvitationDeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("invitation_delivery_status")
}

enum CompanyAccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED

  @@map("company_access_request_status")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("priority")
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  INFORMATION_REQUIRED
  PROPOSAL_READY
  APPROVED
  REJECTED
  CLOSED

  @@map("request_status")
}

enum RequestActivityType {
  CREATED
  UPDATED
  SUBMITTED
  REVIEW_STARTED
  INFORMATION_REQUESTED
  INFORMATION_PROVIDED
  PROPOSAL_READY
  ACCEPTED
  REJECTED
  CONVERTED_TO_PROJECT

  @@map("request_activity_type")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED

  @@map("project_status")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED

  @@map("milestone_status")
}

enum DocumentStatus {
  DRAFT
  UPLOADED
  ARCHIVED
  DELETED

  @@map("document_status")
}

enum MessageStatus {
  SENT
  READ
  ARCHIVED
  DELETED

  @@map("message_status")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  REFUNDED

  @@map("invoice_status")
}

enum ProviderStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  ACTIVE
  SUSPENDED
  REJECTED
  ARCHIVED

  @@map("provider_status")
}

enum ProviderReviewAction {
  APPROVED
  REJECTED
  CHANGES_REQUESTED

  @@map("provider_review_action")
}

enum AuditActorKind {
  USER
  PROVIDER
  SDK_STAFF
  SYSTEM

  @@map("audit_actor_kind")
}

enum VerificationType {
  IDENTITY
  BUSINESS_REGISTRATION
  VAT_TAX
  BANK_PAYOUT
  PROFESSIONAL_CREDENTIAL

  @@map("verification_type")
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  IN_PROGRESS
  VERIFIED
  FAILED
  EXPIRED
  WAIVED

  @@map("verification_status")
}

enum VerificationEvidenceStatus {
  PENDING
  UPLOADED
  ARCHIVED

  @@map("verification_evidence_status")
}

enum CommercialStatus {
  NOT_READY
  READY
  SUSPENDED

  @@map("commercial_status")
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("absence_status")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED

  @@map("reservation_status")
}

enum ServiceStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  PUBLISHED
  UNPUBLISHED

  @@map("service_status")
}

enum PricingModel {
  HOURLY
  FIXED_PROJECT
  RETAINER
  DAY_RATE

  @@map("pricing_model")
}

enum ServiceReviewAction {
  APPROVED
  REJECTED
  CHANGES_REQUESTED

  @@map("service_review_action")
}

enum ServiceMediaAssetKind {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER

  @@map("service_media_asset_kind")
}

model User {
  id              String        @id @default(uuid())
  auth0Sub        String        @unique
  email           String        @unique @db.VarChar(255)
  name            String        @db.VarChar(255)
  avatarUrl       String?       @db.VarChar(1024)
  preferredLocale String        @default("en") @db.VarChar(5)
  sdkStaffRole    SdkStaffRole?
  isActive        Boolean       @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships         Membership[]      @relation("UserMemberships")
  invitedMembers      Membership[]      @relation("MembershipInvitations")
  requests            Request[]         @relation("RequestSubmittedBy")
  reviewedRequests    Request[]         @relation("RequestReviewedBy")
  requestActivities   RequestActivity[]
  projects            Project[]         @relation("ProjectCreatedBy")
  messages            Message[]
  invoices            Invoice[]
  documents           Document[]
  sentInvitations     Invitation[]      @relation("InvitationInviter")
  acceptedInvitations Invitation[]      @relation("InvitationAcceptor")
  accessRequests      CompanyAccessRequest[] @relation("CompanyAccessRequestUser")
  resolvedAccessRequests CompanyAccessRequest[] @relation("CompanyAccessRequestResolver")
  provider            Provider?
  auditEvents         AuditEvent[]
  providerReviews     ProviderReview[]
  serviceReviews      ProviderServiceReview[]
  uploadedServiceMedia ServiceMediaAsset[]
  verifiedProviders   VerificationRecord[] @relation("VerificationReviewedBy")
  uploadedEvidence    VerificationEvidence[]

  @@index([email])
  @@index([auth0Sub])
  @@index([createdAt])
  @@map("user")
}

model Company {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(255)
  slug       String   @unique @db.VarChar(100)
  accessCode String?  @unique @db.VarChar(16)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships       Membership[]      @relation("CompanyMemberships")
  requests          Request[]
  requestActivities RequestActivity[]
  projects          Project[]
  milestones        Milestone[]
  documents         Document[]
  messages          Message[]
  invoices          Invoice[]
  invitations       Invitation[]
  accessRequests    CompanyAccessRequest[]

  @@index([slug])
  @@index([createdAt])
  @@map("company")
}

model Invitation {
  id             String                   @id @default(uuid())
  tokenHash      String                   @unique @db.VarChar(64)
  email          String                   @db.VarChar(255)
  kind           InvitationKind
  companyId      String?
  clientRole     ClientRole?
  sdkStaffRole   SdkStaffRole?
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedBy     String?
  revokedAt      DateTime?
  deliveryStatus InvitationDeliveryStatus @default(PENDING)
  lastSentAt     DateTime?
  deliveryAttempts Int                    @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  company  Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inviter  User     @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict)
  acceptor User?    @relation("InvitationAcceptor", fields: [acceptedBy], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([companyId])
  @@index([companyId, acceptedAt])
  @@index([invitedBy])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("invitation")
}

model Membership {
  id        String     @id @default(uuid())
  userId    String
  companyId String
  role      ClientRole @default(PROJECT_MEMBER)
  invitedBy String?
  invitedAt DateTime?
  joinedAt  DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user    User    @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation("CompanyMemberships", fields: [companyId], references: [id], onDelete: Cascade)
  inviter User?   @relation("MembershipInvitations", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@index([createdAt])
  @@map("membership")
}

model CompanyAccessRequest {
  id            String                     @id @default(uuid())
  userId        String
  companyId     String
  requestedRole ClientRole                 @default(VIEWER)
  status        CompanyAccessRequestStatus @default(PENDING)
  resolvedAt    DateTime?
  resolvedBy    String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  user     User   @relation("CompanyAccessRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resolver User?  @relation("CompanyAccessRequestResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([userId, status])
  @@index([companyId, createdAt])
  @@map("company_access_request")
}

model Request {
  id                    String        @id @default(uuid())
  companyId             String
  title                 String        @db.VarChar(255)
  description           String        @db.Text
  capability            String        @default("other") @db.VarChar(100)
  businessContext       String?       @db.Text
  supportingInformation String?       @db.Text
  supportingLinks       String[]      @default([])
  status                RequestStatus @default(DRAFT)
  priority              Priority      @default(MEDIUM)
  submittedBy           String
  reviewedBy            String?
  reviewedAt            DateTime?
  closedAt              DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company         Company @relation(fields: [companyId], references: [id])
  submittedByUser User    @relation("RequestSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict)
  reviewedByUser  User?   @relation("RequestReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  projects   Project[]
  documents  Document[]
  messages   Message[]
  invoices   Invoice[]
  activities RequestActivity[]

  @@index([companyId])
  @@index([companyId, updatedAt])
  @@index([status])
  @@index([priority])
  @@index([submittedBy])
  @@index([createdAt])
  @@map("request")
}

model RequestActivity {
  id         String              @id @default(uuid())
  companyId  String
  requestId  String
  actorId    String
  type       RequestActivityType
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  createdAt  DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id])
  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([requestId, createdAt])
  @@index([actorId])
  @@map("request_activity")
}

model Project {
  id          String        @id @default(uuid())
  companyId   String
  requestId   String?
  name        String        @db.VarChar(255)
  description String        @db.Text
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company       Company  @relation(fields: [companyId], references: [id])
  request       Request? @relation(fields: [requestId], references: [id])
  createdByUser User     @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  milestones Milestone[]
  documents  Document[]
  messages   Message[]
  invoices   Invoice[]

  @@index([companyId])
  @@index([requestId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("project")
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  companyId   String
  name        String          @db.VarChar(255)
  description String          @db.Text
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  documents Document[]
  messages  Message[]
  invoices  Invoice[]

  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@map("milestone")
}

model Document {
  id          String         @id @default(uuid())
  companyId   String
  projectId   String?
  milestoneId String?
  requestId   String?
  name        String         @db.VarChar(255)
  storageKey  String         @db.VarChar(1024)
  mimeType    String         @db.VarChar(255)
  sizeBytes   Int
  status      DocumentStatus @default(DRAFT)
  uploadedBy  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company        Company    @relation(fields: [companyId], references: [id])
  project        Project?   @relation(fields: [projectId], references: [id])
  milestone      Milestone? @relation(fields: [milestoneId], references: [id])
  request        Request?   @relation(fields: [requestId], references: [id])
  uploadedByUser User       @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([requestId])
  @@index([uploadedBy])
  @@index([status])
  @@index([createdAt])
  @@map("document")
}

model Message {
  id              String        @id @default(uuid())
  companyId       String
  projectId       String?
  milestoneId     String?
  requestId       String?
  content         String        @db.Text
  authorId        String
  parentMessageId String?
  status          MessageStatus @default(SENT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company       Company    @relation(fields: [companyId], references: [id])
  project       Project?   @relation(fields: [projectId], references: [id])
  milestone     Milestone? @relation(fields: [milestoneId], references: [id])
  request       Request?   @relation(fields: [requestId], references: [id])
  author        User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parentMessage Message?   @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies       Message[]  @relation("MessageReplies")

  @@index([companyId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([requestId])
  @@index([authorId])
  @@index([parentMessageId])
  @@index([status])
  @@index([createdAt])
  @@map("message")
}

model Invoice {
  id          String        @id @default(uuid())
  companyId   String
  projectId   String?
  milestoneId String?
  requestId   String?
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD") @db.VarChar(3)
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime?
  paidAt      DateTime?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  stripeInvoiceId      String?  @unique @db.VarChar(255)
  stripeCustomerId     String?  @db.VarChar(255)
  stripeSubscriptionId String?  @db.VarChar(255)

  company       Company    @relation(fields: [companyId], references: [id])
  project       Project?   @relation(fields: [projectId], references: [id])
  milestone     Milestone? @relation(fields: [milestoneId], references: [id])
  request       Request?   @relation(fields: [requestId], references: [id])
  createdByUser User       @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  payments      Payment[]

  @@index([companyId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([requestId])
  @@index([createdBy])
  @@index([status])
  @@index([companyId, status])
  @@index([createdAt])
  @@map("invoice")
}

model Enquiry {
  id          String   @id @default(uuid())
  companyName String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  website     String?  @db.VarChar(1024)
  capability  String   @db.VarChar(255)
  description String   @db.Text
  environment String?  @db.Text
  timeline    String?  @db.VarChar(255)
  budgetRange String?  @db.VarChar(255)
  context     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("enquiry")
}

model Provider {
  id                  String           @id @default(uuid())
  userId              String           @unique
  status              ProviderStatus   @default(DRAFT)
  businessName        String?          @db.VarChar(255)
  timeZone            String?          @db.VarChar(100)
  professionalTitle   String?          @db.VarChar(255)
  biography           String?          @db.Text
  cvStorageKey        String?          @db.VarChar(1024)
  portfolioUrl        String?          @db.VarChar(1024)
  yearsOfExperience   Int?
  languages           String[]         @default([])
  expectedRateMin     Decimal?         @db.Decimal(10, 2)
  expectedRateMax     Decimal?         @db.Decimal(10, 2)
  linkedinUrl         String?          @db.VarChar(1024)
  githubUrl           String?          @db.VarChar(1024)
  websiteUrl          String?          @db.VarChar(1024)
  businessLegalInfo   String?          @db.Text
  vatInfo             String?          @db.VarChar(255)
  preferredProjectTypes String[]       @default([])
  completenessScore   Int              @default(0)
  commercialStatus    CommercialStatus @default(NOT_READY)
  defaultDailyHours   Decimal?         @db.Decimal(4, 1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  reviews                ProviderReview[]
  services               ProviderService[]
  verificationRecords    VerificationRecord[]
  commercialReadiness    ProviderCommercialReadiness?
  weeklyCapacity         ProviderWeeklyCapacity[]
  absences               ProviderAbsence[]
  capacityReservations   CapacityReservation[]

  @@index([userId])
  @@index([status])
  @@index([commercialStatus])
  @@index([createdAt])
  @@map("provider")
}

model StripeCustomer {
  id              String   @id @default(uuid())
  companyId       String   @unique
  stripeCustomerId String  @unique @db.VarChar(255)
  email           String   @db.VarChar(255)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@map("stripe_customer")
}

model StripeConnectedAccount {
  id               String                @id @default(uuid())
  userId           String                @unique
  accountId        String                @unique @db.VarChar(255)
  type             String?               @db.VarChar(50)
  capabilities     Json?
  requirements     Json?
  detailsSubmitted Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([userId])
  @@map("stripe_connected_account")
}

model Subscription {
  id                    String              @id @default(uuid())
  companyId             String
  stripeSubscriptionId  String              @unique @db.VarChar(255)
  stripeCustomerId      String              @db.VarChar(255)
  stripePriceId         String              @db.VarChar(255)
  status                String              @db.VarChar(50)
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean             @default(false)
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([companyId])
  @@index([stripeCustomerId])
  @@map("subscription")
}

model Payment {
  id                    String              @id @default(uuid())
  invoiceId             String
  stripePaymentIntentId String?             @unique @db.VarChar(255)
  amount                Decimal             @db.Decimal(12, 2)
  currency              String              @default("USD") @db.VarChar(3)
  status                String              @db.VarChar(50)
  providerAccountId     String?             @db.VarChar(255)
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([providerAccountId])
  @@map("payment")
}

model AuditEvent {
  id          String         @id @default(uuid())
  companyId   String?
  actorId     String?
  actorKind   AuditActorKind @default(USER)
  action      String         @db.VarChar(100)
  targetType  String         @db.VarChar(100)
  targetId    String         @db.VarChar(100)
  fromState   String?        @db.VarChar(100)
  toState     String?        @db.VarChar(100)
  metadata    Json?
  createdAt   DateTime       @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([companyId])
  @@index([createdAt])
  @@map("audit_event")
}

model ProviderReview {
  id          String              @id @default(uuid())
  providerId  String
  reviewerId  String
  action      ProviderReviewAction
  reason      String?             @db.Text
  internalNotes String?           @db.Text
  createdAt   DateTime            @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([providerId])
  @@index([reviewerId])
  @@index([createdAt])
  @@map("provider_review")
}

model VerificationRequirement {
  id          String           @id @default(uuid())
  type        VerificationType @unique
  name        String           @db.VarChar(255)
  description String?          @db.Text
  required    Boolean          @default(true)
  enabled     Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("verification_requirement")
}

model VerificationRecord {
  id              String             @id @default(uuid())
  providerId      String
  type            VerificationType
  status          VerificationStatus @default(NOT_STARTED)
  verifiedAt      DateTime?
  expiresAt       DateTime?
  verifiedById    String?
  rejectionReason String?            @db.Text
  internalNotes   String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  provider  Provider              @relation(fields: [providerId], references: [id], onDelete: Cascade)
  verifiedBy User?                 @relation("VerificationReviewedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  evidence   VerificationEvidence[]

  @@unique([providerId, type])
  @@index([providerId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("verification_record")
}

model VerificationEvidence {
  id             String                     @id @default(uuid())
  verificationId String
  name           String                     @db.VarChar(255)
  storageKey     String                     @db.VarChar(1024)
  mimeType       String                     @db.VarChar(255)
  sizeBytes      Int
  contentHash    String?                    @db.VarChar(255)
  status         VerificationEvidenceStatus @default(PENDING)
  uploadedBy     String
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  verification VerificationRecord @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  uploader     User               @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([verificationId])
  @@index([uploadedBy])
  @@index([createdAt])
  @@map("verification_evidence")
}

model ProviderCommercialReadiness {
  id            String    @id @default(uuid())
  providerId    String    @unique
  contractReady Boolean   @default(false)
  payoutReady   Boolean   @default(false)
  taxInfoReady  Boolean   @default(false)
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_commercial_readiness")
}

model ProviderWeeklyCapacity {
  id          String   @id @default(uuid())
  providerId  String
  weekday     Int
  hoursPerDay Decimal  @db.Decimal(4, 1)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, weekday])
  @@index([providerId])
  @@map("provider_weekly_capacity")
}

model ProviderAbsence {
  id         String        @id @default(uuid())
  providerId String
  startDate  DateTime      @db.Date
  endDate    DateTime      @db.Date
  reason     String?       @db.Text
  status     AbsenceStatus @default(PENDING)

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startDate, endDate])
  @@index([status])
  @@map("provider_absence")
}

model CapacityReservation {
  id            String            @id @default(uuid())
  providerId    String
  engagementId  String?
  hoursPerDay   Decimal           @db.Decimal(4, 1)
  startDate     DateTime          @db.Date
  endDate       DateTime          @db.Date
  status        ReservationStatus @default(PENDING)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startDate, endDate])
  @@index([status])
  @@index([engagementId])
  @@map("capacity_reservation")
}

model ProviderService {
  id                String        @id @default(uuid())
  providerId        String
  status            ServiceStatus @default(DRAFT)
  title             String        @db.VarChar(255)
  description       String        @db.Text
  capability        String        @default("other") @db.VarChar(100)
  categoryTags      String[]      @default([])
  pricingModel      PricingModel?
  rateMin           Decimal?      @db.Decimal(10, 2)
  rateMax           Decimal?      @db.Decimal(10, 2)
  currency          String        @default("USD") @db.VarChar(3)
  estimatedDuration String?       @db.VarChar(100)
  deliverables      String?       @db.Text
  completenessScore Int           @default(0)
  publishedAt       DateTime?
  unpublishedAt     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  provider Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviews  ProviderServiceReview[]
  media    ServiceMediaAsset[]

  @@index([providerId])
  @@index([status])
  @@index([capability])
  @@index([createdAt])
  @@map("provider_service")
}

model ProviderServiceReview {
  id         String              @id @default(uuid())
  serviceId  String
  reviewerId String
  action     ServiceReviewAction
  reason     String?             @db.Text
  createdAt  DateTime            @default(now())

  service  ProviderService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  reviewer User            @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([serviceId])
  @@index([reviewerId])
  @@index([createdAt])
  @@map("provider_service_review")
}

model ServiceMediaAsset {
  id         String                @id @default(uuid())
  serviceId  String
  name       String                @db.VarChar(255)
  storageKey String                @db.VarChar(1024)
  mimeType   String                @db.VarChar(255)
  sizeBytes  Int
  kind       ServiceMediaAssetKind @default(OTHER)
  sortOrder  Int                   @default(0)
  uploadedBy String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  service  ProviderService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  uploader User            @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([serviceId])
  @@index([uploadedBy])
  @@index([createdAt])
  @@map("service_media_asset")
}
