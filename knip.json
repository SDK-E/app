{
  "workspaces": {
    "apps/*": {
      "entry": ["src/app/**"]
    },
    "packages/*": {}
  },
  "next": {
    "entry": ["apps/web/src/app/**"]
  },
  "includeEntryExports": true,
  "treatConfigHintsAsErrors": false,
  "ignoreFiles": [
    ".kilo/plugins/**",
    ".opencode/plugins/**",
    "apps/web/src/components/layout/AccessPending.tsx",
    "apps/web/src/components/layout/AccountMenu.tsx",
    "apps/web/src/components/layout/ActiveCompanyLabel.tsx",
    "apps/web/src/components/layout/AppNav.tsx",
    "apps/web/src/components/layout/AppShell.tsx",
    "apps/web/src/components/layout/AppShellFrame.tsx",
    "apps/web/src/components/layout/HeaderNavLinks.tsx",
    "apps/web/src/components/layout/PortalErrorPage.tsx",
    "apps/web/src/components/marketing/ContactSection.tsx",
    "apps/web/src/components/marketing/EngagementsSection.tsx",
    "apps/web/src/components/marketing/Hero.tsx",
    "apps/web/src/components/marketing/ProcessSection.tsx",
    "apps/web/src/components/marketing/ServicesSection.tsx",
    "apps/web/src/components/marketing/WhySdkSection.tsx",
    "apps/web/src/components/portal/**",
    "apps/web/src/lib/app/navigation.ts",
    "apps/web/src/lib/app/render-for-page.ts"
  ],
  "ignoreUnresolved": ["next"],
  "ignoreDependencies": ["@prisma/client", "typescript-eslint"],
  "paths": {
    "@/*": ["./apps/web/src/*"],
    "@platform/types": ["./packages/types/src/index.ts"],
    "@platform/types/*": ["./packages/types/src/*"],
    "@platform/config": ["./packages/config/src/site.ts"],
    "@platform/config/*": ["./packages/config/src/*"],
    "@platform/env": ["./packages/env/src/index.ts"],
    "@platform/db": ["./packages/db/src/index.ts"],
    "@platform/db/client": ["./packages/db/src/generated/prisma/client.ts"],
    "@platform/db/*": ["./packages/db/src/generated/prisma/*"],
    "@platform/core": ["./packages/core/src/index.ts"],
    "@platform/core/*": ["./packages/core/src/*"],
    "@platform/i18n": ["./packages/i18n/src/index.ts"],
    "@platform/i18n/locales/*": ["./packages/i18n/src/locales/*"],
    "@platform/i18n/*": ["./packages/i18n/src/i18n/*"],
    "@platform/test-support/*": ["./packages/test-support/src/*"],
    "@platform/auth": ["./packages/auth/src/index.ts"],
    "@platform/auth/*": ["./packages/auth/src/*"],
    "@platform/users": ["./packages/users/src/index.ts"],
    "@platform/users/*": ["./packages/users/src/*"],
    "@platform/companies": ["./packages/companies/src/index.ts"],
    "@platform/companies/*": ["./packages/companies/src/*"],
    "@platform/email": ["./packages/email/src/index.ts"],
    "@platform/email/*": ["./packages/email/src/*"],
    "@platform/marketing/*": ["./packages/marketing/src/*"],
    "@platform/payments": ["./packages/payments/src/stripe.ts"],
    "@platform/payments/*": ["./packages/payments/src/*"],
    "@platform/notifications": ["./packages/notifications/src/index.ts"],
    "@platform/notifications/*": ["./packages/notifications/src/*"],
    "@platform/providers": ["./packages/providers/src/index.ts"],
    "@platform/providers/*": ["./packages/providers/src/*"],
    "@platform/requests": ["./packages/requests/src/index.ts"],
    "@platform/requests/*": ["./packages/requests/src/*"],
    "@platform/opportunities": ["./packages/opportunities/src/index.ts"],
    "@platform/opportunities/*": ["./packages/opportunities/src/*"],
    "@platform/matching": ["./packages/matching/src/index.ts"],
    "@platform/matching/*": ["./packages/matching/src/*"],
    "@platform/schemas/*": ["./packages/schemas/src/*"],
    "@platform/ui/*": ["./packages/ui/src/*"],
    "@platform/ui/Button": ["./packages/ui/src/Button.tsx"],
    "@platform/ui/Section": ["./packages/ui/src/Section.tsx"],
    "@platform/ui/SectionHeader": ["./packages/ui/src/SectionHeader.tsx"],
    "@platform/ui/Card": ["./packages/ui/src/Card.tsx"],
    "@platform/design-system/*": ["./packages/design-system/src/*"],
    "@platform/portal-shell/*": ["./packages/portal-shell/src/*"],
    "@platform/portal-staff/*": ["./packages/portal-staff/src/*"],
    "@platform/portal-companies/*": ["./packages/portal-companies/src/*"],
    "@platform/portal-providers/*": ["./packages/portal-providers/src/*"]
  },
  "ignoreIssues": {
    "apps/web/src/components/layout/HeaderNavLinks.tsx": ["exports"],
    "apps/web/src/components/marketing/*.tsx": ["exports"],
    "apps/web/src/**/page.tsx": ["exports"],
    "apps/web/src/**/route.ts": ["exports"],
    "apps/web/src/**/loading.tsx": ["exports"],
    "apps/web/src/**/layout.tsx": ["exports"],
    "apps/web/src/**/error.tsx": ["exports"],
    "apps/web/src/**/actions.ts": ["exports"],
    "packages/**/src/index.ts": ["exports", "types", "nsTypes"],
    "packages/**/page.tsx": ["exports"],
    "packages/**/loading.tsx": ["exports"],
    "packages/**/route.ts": ["exports"],
    "packages/**/layout.tsx": ["exports"],
    "packages/**/error.tsx": ["exports"],
    "packages/**/actions.ts": ["exports"],
    "packages/**/src/**/*-actions.ts": ["exports"],
    "packages/**/src/**/media.ts": ["exports"],
    "packages/**/src/**/review.ts": ["exports"],
    "packages/**/src/**/score.ts": ["exports"],
    "packages/**/src/**/draft.ts": ["exports"],
    "packages/**/src/**/publishing.ts": ["exports"],
    "packages/**/src/**/queries.ts": ["exports"],
    "packages/**/src/**/save.ts": ["exports"],
    "packages/**/src/**/submit.ts": ["exports"],
    "packages/**/src/**/availability/**": ["exports", "types"],
    "packages/**/src/**/services/**": ["exports", "types"],
    "packages/**/src/**/verification*.ts": ["exports"],
    "packages/**/src/**/schemas.ts": ["exports"],
    "packages/**/src/**/commercial-readiness.ts": ["exports"],
    "packages/**/src/**/delivery.ts": ["exports"],
    "packages/**/src/**/eligibility-*.ts": ["exports"],
    "packages/**/src/**/invitation-*.ts": ["exports"],
    "packages/**/src/**/invitations.ts": ["exports"],
    "packages/**/src/**/stripe*.ts": ["exports"],
    "packages/**/src/**/weights.ts": ["exports"],
    "packages/**/src/**/positions.ts": ["exports"],
    "packages/**/src/**/attachments.ts": ["exports"],
    "packages/core/src/money.ts": ["exports", "types"],
    "packages/matching/src/types.ts": ["exports", "types"],
    "packages/marketing/src/seo.ts": ["exports"],
    "packages/opportunities/src/safe.ts": ["exports", "types"],
    "packages/opportunities/src/workflow/index.ts": ["exports", "types"],
    "packages/schemas/src/userManagement.ts": ["exports", "types"],
    "packages/tooling/src/**": ["exports", "types"],
    "packages/ui/src/Avatar.tsx": ["exports"],
    "packages/ui/src/DropdownMenu.tsx": ["exports"],
    "packages/ui/src/Select.tsx": ["exports"],
    "packages/ui/src/IconButton.tsx": ["types"],
    "packages/users/src/tabs.ts": ["exports"],
    "packages/users/src/list-links.ts": ["exports"],
    "packages/users/src/shared.ts": ["exports"],
    "packages/users/src/user-detail.ts": ["exports", "types"],
    "packages/requests/src/types.ts": ["exports", "types"],
    "packages/providers/src/schemas.ts": ["exports", "types"],
    "packages/portal-providers/src/app/opportunities/actions.ts": ["exports", "types"],
    "packages/portal-providers/src/app/providers/actions.ts": ["exports", "types"]
  }
}
