{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@platform/types": ["../../packages/types/src/index.ts"],
      "@platform/types/*": ["../../packages/types/src/*"],
      "@platform/config": ["../../packages/config/src/site.ts"],
      "@platform/config/*": ["../../packages/config/src/*"],
      "@platform/env": ["../../packages/env/src/index.ts"],
      "@platform/db": ["../../packages/db/src/index.ts"],
      "@platform/db/client": ["../../packages/db/src/generated/prisma/client.ts"],
      "@platform/db/*": ["../../packages/db/src/generated/prisma/*"],
      "@platform/core": ["../../packages/core/src/index.ts"],
      "@platform/core/*": ["../../packages/core/src/*"],
      "@platform/i18n": ["../../packages/i18n/src/index.ts"],
      "@platform/i18n/locales/*": ["../../packages/i18n/src/locales/*"],
      "@platform/i18n/*": ["../../packages/i18n/src/i18n/*"],
      "@platform/test-support/*": ["../../packages/test-support/src/*"],
      "@platform/auth": ["../../packages/auth/src/index.ts"],
      "@platform/auth/*": ["../../packages/auth/src/*"],
      "@platform/users": ["../../packages/users/src/index.ts"],
      "@platform/users/*": ["../../packages/users/src/*"],
      "@platform/companies": ["../../packages/companies/src/index.ts"],
      "@platform/companies/*": ["../../packages/companies/src/*"],
      "@platform/email": ["../../packages/email/src/index.ts"],
      "@platform/email/*": ["../../packages/email/src/*"],
      "@platform/marketing/*": ["../../packages/marketing/src/*"],
      "@platform/payments": ["../../packages/payments/src/stripe.ts"],
      "@platform/payments/*": ["../../packages/payments/src/*"],
      "@platform/notifications": ["../../packages/notifications/src/index.ts"],
      "@platform/notifications/*": ["../../packages/notifications/src/*"],
      "@platform/providers": ["../../packages/providers/src/index.ts"],
      "@platform/providers/*": ["../../packages/providers/src/*"],
      "@platform/requests": ["../../packages/requests/src/index.ts"],
      "@platform/requests/*": ["../../packages/requests/src/*"],
      "@platform/opportunities": ["../../packages/opportunities/src/index.ts"],
      "@platform/opportunities/*": ["../../packages/opportunities/src/*"],
      "@platform/matching": ["../../packages/matching/src/index.ts"],
      "@platform/matching/*": ["../../packages/matching/src/*"],
      "@platform/schemas/*": ["../../packages/schemas/src/*"],
      "@platform/ui/*": ["../../packages/ui/src/*"],
      "@platform/design-system/*": ["../../packages/design-system/src/*"],
      "@platform/portal-shell/*": ["../../packages/portal-shell/src/*"],
      "@platform/portal-staff/*": ["../../packages/portal-staff/src/*"],
      "@platform/portal-companies/*": ["../../packages/portal-companies/src/*"],
      "@platform/portal-providers/*": ["../../packages/portal-providers/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
