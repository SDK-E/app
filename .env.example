# ============================================================
# Environment Variables — SDK Enterprises Platform
# ============================================================
# Server-only variables are NEVER exposed to the browser.
# Public variables may be safely included in client bundles.
# ============================================================

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

# Server-only: PostgreSQL connection string (required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# ------------------------------------------------------------
# AUTH0 — Server-only secrets
# ------------------------------------------------------------

# Server-only: Auth0 session encryption secret (required)
# Generate with: openssl rand -hex 32
# Minimum 32 characters.
AUTH0_SECRET=

# Server-only: Auth0 tenant domain used for token validation (required)
# Example: https://dev-xxx.us.auth0.com
AUTH0_ISSUER_BASE_URL=

# Server-only: Auth0 application base URL (required)
# The root URL where your application is hosted.
AUTH0_BASE_URL=

# Server-only: Auth0 application client secret (required)
AUTH0_CLIENT_SECRET=

# ------------------------------------------------------------
# AUTH0 — Public configuration
# ------------------------------------------------------------

# Public: Auth0 application client ID (required)
# Safe to expose to the browser; used in the Auth0 SDK callback.
AUTH0_CLIENT_ID=

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

# Environment: development | test | production
NODE_ENV=development
