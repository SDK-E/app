# Database
# Server-only. Primary database connection string.
DATABASE_URL=your-database-url

# Authentication
# Server-only. Secret used for signing authentication tokens and cookies.
AUTH_SECRET=your-auth-secret

# Server-only. Secret used by NextAuth.js for session encryption.
NEXTAUTH_SECRET=your-nextauth-secret

# Server-only. Base URL for the application, used by NextAuth.js for callbacks.
NEXTAUTH_URL=https://example.com

# Public API
# Public. Base URL for the API consumed by the client.
NEXT_PUBLIC_API_URL=https://example.com
