# Server-only: Database connection string (required)
DATABASE_URL=

# Server-only: Auth0 secret for session encryption (required)
AUTH0_SECRET=

# Server-only: Auth0 issuer base URL (required)
AUTH0_ISSUER_BASE_URL=

# Server-only: Auth0 base URL (required)
AUTH0_BASE_URL=

# Environment: development | test | production
NODE_ENV=development
