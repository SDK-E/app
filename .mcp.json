{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--browser", "chromium"]
    },
    "prisma": {
      "command": "npx",
      "args": ["prisma", "mcp"]
    },
    "maildev": {
      "command": "node",
      "args": ["scripts/mail-mcp.ts"]
    },
    "humanizer": {
      "command": "node",
      "args": ["--import", "tsx", "scripts/humanizer-mcp.ts"]
    },
    "gh_grep": {
      "url": "https://mcp.grep.app"
    }
  }
}
