{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "prisma": {
      "command": "npx",
      "args": ["prisma", "mcp"]
    },
    "gh_grep": {
      "url": "https://mcp.grep.app"
    }
  }
}
