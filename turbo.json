{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "@sdk-e/db#generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "POSTGRES_URL",
        "PRISMA_DATABASE_URL",
        "AUTH0_SECRET",
        "AUTH0_DOMAIN",
        "AUTH0_ISSUER_BASE_URL",
        "AUTH0_BASE_URL",
        "AUTH0_CLIENT_ID",
        "AUTH0_CLIENT_SECRET",
        "RESEND_API_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PUBLISHABLE_KEY",
        "NEON_DATABASE_URL",
        "NEON_DATABASE_URL_UNPOOLED",
        "NEON_POSTGRES_URL",
        "NEON_POSTGRES_URL_NON_POOLING",
        "NEON_POSTGRES_PRISMA_URL",
        "NEON_PGHOST",
        "NEON_PGHOST_UNPOOLED",
        "NEON_PGUSER",
        "NEON_PGDATABASE",
        "NEON_POSTGRES_USER",
        "NEON_POSTGRES_HOST",
        "NEON_POSTGRES_DATABASE",
        "NEON_POSTGRES_PASSWORD",
        "NEON_PGPASSWORD",
        "NEON_PROJECT_ID"
      ]
    },
    "generate": {
      "env": [
        "DATABASE_URL",
        "POSTGRES_URL",
        "PRISMA_DATABASE_URL",
        "NEON_DATABASE_URL",
        "NEON_DATABASE_URL_UNPOOLED",
        "NEON_POSTGRES_URL",
        "NEON_POSTGRES_URL_NON_POOLING",
        "NEON_POSTGRES_PRISMA_URL",
        "NEON_PGHOST",
        "NEON_PGHOST_UNPOOLED",
        "NEON_PGUSER",
        "NEON_PGDATABASE",
        "NEON_POSTGRES_USER",
        "NEON_POSTGRES_HOST",
        "NEON_POSTGRES_DATABASE",
        "NEON_POSTGRES_PASSWORD",
        "NEON_PGPASSWORD",
        "NEON_PROJECT_ID"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:run": {}
  },
  "globalEnv": [
    "DATABASE_URL",
    "POSTGRES_URL",
    "PRISMA_DATABASE_URL",
    "AUTH0_SECRET",
    "AUTH0_DOMAIN",
    "AUTH0_ISSUER_BASE_URL",
    "AUTH0_BASE_URL",
    "AUTH0_CLIENT_ID",
    "AUTH0_CLIENT_SECRET",
    "RESEND_API_KEY",
    "MAIL_SMTP_URL",
    "MAIL_HTTP_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_PUBLISHABLE_KEY",
    "STRIPE_MCP_KEY",
    "NEON_DATABASE_URL",
    "NEON_DATABASE_URL_UNPOOLED",
    "NEON_POSTGRES_URL",
    "NEON_POSTGRES_URL_NON_POOLING",
    "NEON_POSTGRES_PRISMA_URL",
    "NEON_PGHOST",
    "NEON_PGHOST_UNPOOLED",
    "NEON_PGUSER",
    "NEON_PGDATABASE",
    "NEON_POSTGRES_USER",
    "NEON_POSTGRES_HOST",
    "NEON_POSTGRES_DATABASE",
    "NEON_POSTGRES_PASSWORD",
    "NEON_PGPASSWORD",
    "NEON_PROJECT_ID"
  ],
  "globalDependencies": [
    "**/.env",
    "**/.env.local"
  ]
}
