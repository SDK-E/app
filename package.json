{
  "name": "@sdk-e/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:migrate": "pnpm --filter @platform/db exec prisma migrate deploy",
    "dev": "pnpm --filter @platform/web dev",
    "mail:ui": "mailbox-cli open",
    "mail:list": "mailbox-cli list",
    "mail:read": "mailbox-cli read",
    "mail:clear": "mailbox-cli clear",
    "mail:wait": "mailbox-cli wait",
    "mail:health": "mailbox-cli health",
    "build": "pnpm run generate && turbo run build",
    "start": "pnpm --filter @platform/web start",
    "generate": "pnpm --filter @platform/db run generate",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "contrast:check": "node --import tsx packages/tooling/src/ci/contrast/rendered.ts",
    "test": "pnpm run generate && vitest",
    "test:run": "pnpm run generate && vitest run",
    "test:coverage": "pnpm run generate && vitest run --coverage",
    "agents:check": "node --import tsx packages/tooling/src/ci/check-agent-contract.ts",
    "check:file-length": "node --import tsx packages/tooling/src/ci/check-file-length.ts",
    "knip": "knip --use-tsconfig-files",
    "verify": "pnpm run generate && pnpm run agents:check && pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run knip && vitest run && pnpm run i18n:check && pnpm run build",
    "audit": "pnpm audit --audit-level=high",
    "i18n:translate": "python3 packages/tooling/i18n/translate-locales.py",
    "i18n:check": "python3 packages/tooling/i18n/translate-locales-test.py && python3 packages/tooling/i18n/translate-locales.py --check",
    "bg:remove": "node --import tsx packages/tooling/src/images/remove-background.ts",
    "port:list": "node --import tsx packages/tooling/src/portkiller/portkiller.ts list",
    "port:find": "node --import tsx packages/tooling/src/portkiller/portkiller.ts find",
    "port:pid": "node --import tsx packages/tooling/src/portkiller/portkiller.ts pid",
    "port:check": "node --import tsx packages/tooling/src/portkiller/portkiller.ts check",
    "port:kill": "node --import tsx packages/tooling/src/portkiller/portkiller.ts kill",
    "port:kill-force": "node --import tsx packages/tooling/src/portkiller/portkiller.ts kill-force"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@sdk-e/mailbox": "^0.1.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^28.1.0",
    "knip": "^6.33.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "shadcn": "^4.19.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
