{
  "name": "@sdk-e/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @platform/web dev",
    "start": "pnpm --filter @platform/web start",
    "build": "pnpm run generate && turbo run build",
    "generate": "pnpm --filter @platform/db run generate",
    "db:dev": "pnpm --filter @platform/db exec prisma dev --detach -n app -P 5432",
    "db:migrate": "pnpm run db:dev 2>/dev/null; pnpm --filter @platform/db exec prisma migrate deploy",
    "db:reset": "pnpm --filter @platform/db exec prisma migrate reset",
    "db:status": "pnpm --filter @platform/db exec prisma migrate status",
    "db:push": "pnpm --filter @platform/db exec prisma db push",
    "knip": "knip",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "agents:check": "node --import tsx packages/tooling/src/ci/check-agent-contract.ts",
    "contrast:check": "node --import tsx packages/tooling/src/ci/contrast/rendered.ts",
    "i18n:translate": "python3 packages/tooling/i18n/translate-locales.py",
    "i18n:check": "python3 packages/tooling/i18n/translate-locales-test.py && python3 packages/tooling/i18n/translate-locales.py --check",
    "verify": "pnpm run generate && pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run i18n:check && pnpm run test:run && pnpm run build",
    "audit": "pnpm audit --audit-level=high",
    "bg:remove": "node --import tsx packages/tooling/src/images/remove-background.ts",
    "port:list": "node --import tsx packages/tooling/src/portkiller/portkiller.ts list",
    "port:find": "node --import tsx packages/tooling/src/portkiller/portkiller.ts find",
    "port:pid": "node --import tsx packages/tooling/src/portkiller/portkiller.ts pid",
    "port:check": "node --import tsx packages/tooling/src/portkiller/portkiller.ts check",
    "port:kill": "node --import tsx packages/tooling/src/portkiller/portkiller.ts kill",
    "port:kill-force": "node --import tsx packages/tooling/src/portkiller/portkiller.ts kill-force"
  },
  "pnpm": {
    "node-linker": "hoisted"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^28.1.0",
    "knip": "^6.33.0",
    "prettier": "3.9.6",
    "shadcn": "^4.19.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
