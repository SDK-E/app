{
  "name": "client-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,mail -c blue,green \"next dev --turbopack\" \"node scripts/mail-sink.ts\"",
    "mail": "node scripts/mail-sink.ts",
    "mail:list": "node scripts/mail-cli.ts list",
    "mail:read": "node scripts/mail-cli.ts read",
    "mail:clear": "node scripts/mail-cli.ts clear",
    "mail:wait": "node scripts/mail-cli.ts wait",
    "mail:health": "node scripts/mail-cli.ts health",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "prisma generate && vitest",
    "test:run": "prisma generate && vitest run",
    "agents:check": "node --import tsx scripts/check-agent-contract.ts",
    "verify": "npm run agents:check && npm run typecheck && npm run lint && npm run test:run && npm run i18n:check && npm run build",
    "i18n:translate": "python3 scripts/translate-locales.py",
    "i18n:check": "python3 scripts/translate-locales-test.py && python3 scripts/translate-locales.py --check"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.26.0",
    "@internationalized/date": "^3.12.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-table": "^9.1.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^16.6.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-intl": "^4.13.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^28.1.0",
    "nodemailer": "^9.0.5",
    "prisma": "^7.9.1",
    "smtp-tester": "^2.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "undici": "7.29.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.0": true
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead",
    "not op_mini"
  ]
}
