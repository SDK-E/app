{
  "name": "sdk-e-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:migrate": "pnpm --filter @sdk-e/db exec prisma migrate deploy",
    "dev": "concurrently -k -n app,mail -c blue,green \"pnpm --filter @sdk-e/web dev\" \"node --import tsx packages/tooling/src/mail/mail-sink.ts\"",
    "mail": "node --import tsx packages/tooling/src/mail/mail-sink.ts",
    "mail:ui": "node --import tsx packages/tooling/src/mail/mail-open.ts",
    "mail:list": "node --import tsx packages/tooling/src/mail/mail-cli.ts list",
    "mail:read": "node --import tsx packages/tooling/src/mail/mail-cli.ts read",
    "mail:clear": "node --import tsx packages/tooling/src/mail/mail-cli.ts clear",
    "mail:wait": "node --import tsx packages/tooling/src/mail/mail-cli.ts wait",
    "mail:health": "node --import tsx packages/tooling/src/mail/mail-cli.ts health",
    "build": "pnpm run generate && turbo run build",
    "start": "pnpm --filter @sdk-e/web start",
    "generate": "pnpm --filter @sdk-e/db run generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "contrast:check": "node --import tsx packages/tooling/src/ci/contrast/rendered.ts",
    "test": "pnpm run generate && vitest",
    "test:run": "pnpm run generate && vitest run",
    "test:coverage": "pnpm run generate && vitest run --coverage",
    "agents:check": "node --import tsx packages/tooling/src/ci/check-agent-contract.ts",
    "check:file-length": "node --import tsx packages/tooling/src/ci/check-file-length.ts",
    "verify": "pnpm run generate && pnpm run agents:check && pnpm run check:file-length && pnpm run format:check && pnpm run typecheck && pnpm run lint && vitest run && pnpm run i18n:check && pnpm run build",
    "audit": "pnpm audit --audit-level=high",
    "i18n:translate": "python3 packages/tooling/i18n/translate-locales.py",
    "i18n:check": "python3 packages/tooling/i18n/translate-locales-test.py && python3 packages/tooling/i18n/translate-locales.py --check",
    "bg:remove": "node --import tsx packages/tooling/src/images/remove-background.ts",
    "port:list": "node --import tsx packages/tooling/src/portkiller/portkiller.ts list",
    "port:find": "node --import tsx packages/tooling/src/portkiller/portkiller.ts find",
    "port:pid": "node --import tsx packages/tooling/src/portkiller/portkiller.ts pid",
    "port:check": "node --import tsx packages/tooling/src/portkiller/portkiller.ts check",
    "port:kill": "node --import tsx packages/tooling/src/portkiller/portkiller.ts kill",
    "port:kill-force": "node --import tsx packages/tooling/src/portkiller/portkiller.ts kill-force"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.5",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^28.1.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "shadcn": "^4.18.0",
    "tsx": "^4.7.0",
    "turbo": "^2.5.8",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
